# Google OAuth Client ID for read-only Google Calendar sync (optional).
# Public identifier, not a secret — safe to ship in client JS.
# Create one at https://console.cloud.google.com (OAuth client, "Web application").
# The app also works without this: you can paste a Client ID in the sidebar card.
VITE_GOOGLE_CLIENT_ID=

# Supabase — cloud account sync across devices (optional).
# Both are public, client-safe values (Row Level Security protects the data).
# Find them in your Supabase project → Settings → API. When absent, the app
# runs local-only (no login shown) exactly as before.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
